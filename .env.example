APP_NAME="Raindear Coffee & Kitchen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=raindear
DB_USERNAME=raindear
DB_PASSWORD=raindear
# Or use sqlite for local dev:
# DB_CONNECTION=sqlite

# Cache / Queue / Session — default to db; switch to redis when available
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Sanctum / SPA
# Comma-separated list of stateful domains for the SPA (no scheme/port for stateful checks).
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173,localhost:8000
SESSION_DOMAIN=localhost
# CORS — comma-separated origins allowed to call the API (with scheme + port).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Mail (used by reservation/contact form notifications)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=mkt.raindear@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Storage — switch to s3 for production
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"
